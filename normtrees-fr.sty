%% normtrees-fr.sty -- Notations des arbres normatifs (JFLA 2027).
%%
%% Compatible avec jflart : aucun paquet de police ni environnement de
%% théorème n'est déclaré ici. La classe fournit les environnements
%% defi, theo, prop, lemm, coro, remark et exem.
%%
%% Conventions typographiques :
%%   \mathsf : types nommés, constantes et certains constructeurs ;
%%   \mathit : fonctions et opérateurs du modèle ;
%%   \mathcal : domaines, familles et ensembles de matières ou de sources ;
%%   \mathbb : ensembles usuels.
%% Les graphies mathématiques sont sans accents.
%% Les noms et le rendu des macros existantes sont conservés.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{normtrees-fr}[2026/10/13 v1.1 Notations des arbres normatifs (FR)]

%% --------------------------------------------------------------------
%% Dépendances
%% --------------------------------------------------------------------
\RequirePackage{amsmath,amssymb}
\RequirePackage{stmaryrd} % Crochets sémantiques : \llbracket, \rrbracket.
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}

%% --------------------------------------------------------------------
%% Références automatiques en français
%% --------------------------------------------------------------------
\newcommand{\reneworprovidecommand}[2]{%
  \providecommand{#1}{}%
  \renewcommand{#1}{#2}%
}

\reneworprovidecommand{\defiautorefname}{Définition}
\reneworprovidecommand{\propautorefname}{Proposition}
\reneworprovidecommand{\theoremautorefname}{Théorème}
\reneworprovidecommand{\lemmautorefname}{Lemme}
\reneworprovidecommand{\coroautorefname}{Corollaire}
\reneworprovidecommand{\remarkautorefname}{Remarque}
\reneworprovidecommand{\subsectionautorefname}{Section}
\reneworprovidecommand{\sectionautorefname}{Section}
\providecommand*{\algorithmautorefname}{Algorithme}

%% --------------------------------------------------------------------
%% Pseudocode en français
%% --------------------------------------------------------------------
\floatname{algorithm}{Algorithme}
\algrenewcommand{\algorithmicwhile}{\textbf{tant que}}
\algrenewcommand{\algorithmicdo}{\textbf{faire}}
\algrenewcommand{\algorithmicif}{\textbf{si}}
\algrenewcommand{\algorithmicthen}{\textbf{alors}}
\algrenewcommand{\algorithmicelse}{\textbf{sinon}}
\algrenewcommand{\algorithmicend}{\textbf{fin}}
\algrenewcommand{\algorithmicreturn}{\textbf{retourner}}

