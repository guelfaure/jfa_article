%% normtrees-fr.sty -- notations pour les « arbres normatifs »
%% Version française (soumission JFLA 2027), adaptée de normtrees.sty.
%%
%% Compatible avec la classe jflart : ce fichier ne charge AUCUN paquet de
%% police (pas de mathptmx), ne redéfinit aucun paramètre typographique et
%% ne déclare aucun environnement de théorème (la classe fournit déjà
%% defi, theo, prop, lemm, coro, remark, exem).
%%
%% Conventions
%%   \mathsf{...}   ensembles nommés, constantes, constructeurs, opérations
%%   \mathit{...}   fonctions définies par équations (gagnant, select, Requis)
%%   \mathcal{...}  domaines de valeurs et familles d'arbres
%%   \mathbb{...}   ensembles usuels (B_3, N)
%% Les identifiants en \mathsf sont écrits sans accents, comme dans le
%% document de formalisation (Indemnite, Anciennete, SalaireDeReference...).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{normtrees-fr}[2026/09/29 v1.0 Notations pour les arbres normatifs (FR)]

\RequirePackage{amsmath,amssymb}
\RequirePackage{stmaryrd}   % \llbracket, \rrbracket (symboles seulement)

%%
%% Autorefname
%%
\newcommand{\reneworprovidecommand}[2]{%
  \providecommand{#1}{}%
  \renewcommand{#1}{#2}%
}

\reneworprovidecommand{\definitionautorefname}{Définition}
\reneworprovidecommand{\propositionautorefname}{Proposition}
\reneworprovidecommand{\theoremautorefname}{Théorème}
\reneworprovidecommand{\lemmaautorefname}{Lemme}
\reneworprovidecommand{\corollaryautorefname}{Corollaire}
\reneworprovidecommand{\remarkautorefname}{Remarque}
\reneworprovidecommand{\subsectionautorefname}{sous-section}
\reneworprovidecommand{\sectionautorefname}{section}

%% --------------------------------------------------------------------
%% Outils génériques
%% --------------------------------------------------------------------
\newcommand{\mc}[1]{\mathcal{#1}}
\newcommand{\sem}[1]{\ensuremath{\llbracket #1\rrbracket}}  % crochets sémantiques
\newcommand{\subtype}{\mathrel{<\!:}}                        % sous-typage des sources

%% Ordre normatif
\newcommand{\normgt}{\succ_{\mathit{norm}}}
\newcommand{\normge}{\succeq_{\mathit{norm}}}
\newcommand{\normlt}{\prec_{\mathit{norm}}}
\newcommand{\normdown}{\mathop{\downarrow_{\mathit{norm}}}}

%% --------------------------------------------------------------------
%% Matières et domaines de valeurs (déf. 1)
%% --------------------------------------------------------------------
\newcommand{\Matter}{\ensuremath{\mathsf{Matiere}}}
\newcommand{\CMatter}{\ensuremath{\mathcal{M}_{\downarrow}}}
\newcommand{\Raw}{\ensuremath{\mathcal{V}}}                 % domaine : \Raw(m)
\newcommand{\Money}{\ensuremath{\mathsf{Montant}}}
\newcommand{\Duration}{\ensuremath{\mathsf{Duree}}}
\newcommand{\DateT}{\ensuremath{\mathsf{Date}}}
\newcommand{\IDCC}{\ensuremath{\mathsf{IDCC}}}

% Matières utilisées dans les exemples
\newcommand{\Indem}{\ensuremath{\mathsf{Indemnite}}}
\newcommand{\IndemLeg}{\ensuremath{\mathsf{IndemniteLegale}}}
\newcommand{\Senior}{\ensuremath{\mathsf{Anciennete}}}
\newcommand{\Salary}{\ensuremath{\mathsf{SalaireDeReference}}}

%% --------------------------------------------------------------------
%% Favorabilité (déf. 2)
%% --------------------------------------------------------------------
\newcommand{\fav}[1]{\mathrel{\sqsubseteq_{#1}}}      % x \fav{m} y : y au moins aussi favorable
\newcommand{\strictfav}[1]{\mathrel{\sqsubset_{#1}}}  % partie stricte
\newcommand{\MatterOrd}{\ensuremath{\mc M^{\fav{}}}}

%% --------------------------------------------------------------------
%% Dossiers (déf. 3) et constructeurs
%% --------------------------------------------------------------------
\newcommand{\Dossier}{\ensuremath{\mathsf{Dossier}}}
\newcommand{\EmptyD}{\ensuremath{\mathbf{0}_\Dossier}}
\newcommand{\Input}{\ensuremath{\mathit{Saisir}}}      % \Input(D,m,x)
\newcommand{\Prune}{\ensuremath{\mathit{Elaguer}}}     % \Prune(D,m)
\newcommand{\Resolve}{\ensuremath{\mathit{Resoudre}}}  % \Resolve(D,m)
% Partition des matières d'un dossier D (l'indice D est intégré)
\newcommand{\Res}{\ensuremath{\mathit{Resolue}_D}}
\newcommand{\Unres}{\ensuremath{\mathit{NonResolue}_D}}
\newcommand{\Undef}{\ensuremath{\mathit{Indefinie}_D}}
\newcommand{\Unest}{\ensuremath{\mathit{NonEtablie}_D}}
\newcommand{\UnresOf}[1]{\ensuremath{\mathit{NonResolue}_{#1}}}
\newcommand{\dep}{\ensuremath{\mathit{dep}}}

